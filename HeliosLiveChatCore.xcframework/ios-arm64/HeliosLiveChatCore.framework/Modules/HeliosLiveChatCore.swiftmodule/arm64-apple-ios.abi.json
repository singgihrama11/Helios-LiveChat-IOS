      "kind": "StringLiteral",
      "offset": 594,
      "length": 728,
      "value": "\"(function () {\n  if (window.__heliosBridge) return;\n  window.__heliosBridge = 1;\n  var ready = false, queue = [];\n  function post(m) { window.postMessage(m, '*'); if (window.__heliosDebug) { try { console.log('[helios] sent ' + m.type); } catch (e) {} } }\n  function flush() { ready = true; while (queue.length) post(queue.shift()); }\n  window.addEventListener('message', function (e) { if (e.data === 'iframeReady') flush(); });\n  setTimeout(function () { if (!ready) flush(); }, 3000);\n  window.__heliosSetMemberPayload = function (p) {\n    var m = { type: 'SET_MEMBER_PAYLOAD', payload: p };\n    if (ready) { post(m); return; }\n    queue.push(m);\n  };\n})();\""
