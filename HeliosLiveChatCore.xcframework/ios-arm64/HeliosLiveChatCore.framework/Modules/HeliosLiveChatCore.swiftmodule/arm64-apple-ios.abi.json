      "filePath": "\/Users\/singgihramapradana\/Project\/HeliosLiveChatCore\/Sources\/HeliosLiveChatCore\/SessionScriptHandler.swift",
      "kind": "StringLiteral",
      "offset": 2343,
      "length": 1373,
      "value": "\"(function () {\n  if (window.__heliosSessionWatch) return;\n  window.__heliosSessionWatch = 1;\n  var lastToken, lastId = null, busy = false;\n  function log(m) { if (!window.__heliosDebug) return; try { console.log('[helios] ' + m); } catch (e) {} }\n  function keys() { try { return Object.keys(localStorage).join(','); } catch (e) { return '?'; } }\n  function resolve(t) {\n    busy = true;\n    fetch('<API_BASE>\/member\/checkme', { headers: { 'Authorization': 'Bearer ' + t } })\n      .then(function (r) { if (!r.ok) { log('checkme HTTP ' + r.status); return null; } return r.json(); })\n      .then(function (j) {\n        if (!j) return;\n        var id = j.data && j.data.chat_session;\n        if (!id) { log('no chat_session yet'); return; }\n        if (id !== lastId) { lastId = id; HeliosSession.postMessage(id); }\n      })\n      .catch(function (e) { log('checkme failed: ' + e); })\n      .then(function () { busy = false; });\n  }\n  setInterval(function () {\n    var t = null;\n    try { t = localStorage.getItem('kouventa-livechat.access_token'); } catch (e) {}\n    if (t !== lastToken) { lastToken = t; lastId = null; log(t ? 'token found' : 'no token, keys=[' + keys() + ']'); }\n    if (!t || lastId || busy) return;\n    resolve(t);\n  }, 2000);\n})();\""
